{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polsek-kapuas-tengah",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "polsekkapuastengah.id", "custom_domain": true },
    { "pattern": "www.polsekkapuastengah.id", "custom_domain": true },
    { "pattern": "admin.polsekkapuastengah.id", "custom_domain": true }
  ]
}
